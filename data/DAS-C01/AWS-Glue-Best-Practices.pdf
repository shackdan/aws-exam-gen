              define.
            </div>
                        </a>
                    </article>
                    <article class="awsdocs-card">
                        <a href="/glue/latest/dg/populate-add-connection.html" class="awsdocs-card-link">
                            <h3 class="awsdocs-card-title">Add connections to your Data Catalog</h3>
                            <div class="awsdocs-abstract">
              Use AWS Glue connections to access certain types of data stores.
            </div>
                        </a>
                    </article>
                </div>
            </section>
